# Copy to .env and fill in. Never commit .env.
# Loaded automatically by forge from the repository root.

# --- Network ---------------------------------------------------------------
# Resolved by the `arbitrum_sepolia` / `arbitrum_one` aliases in foundry.toml,
# so scripts are invoked as `--rpc-url arbitrum_sepolia`.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# --- Verification ----------------------------------------------------------
# An Etherscan V2 key from etherscan.io covers Arbiscan on both chains.
ARBISCAN_API_KEY=

# --- Deployer --------------------------------------------------------------
# A plain EOA used once, for the two CREATE transactions. It is unrelated to
# any user's P-256 key and holds no authority over either contract afterwards.
# Preferred: an encrypted keystore, used as `--account $DEPLOYER_ACCOUNT`.
#   cast wallet import cryple-deployer --interactive
DEPLOYER_ACCOUNT=cryple-deployer
# Fallback for throwaway testnet keys only, used as
# `--private-key $DEPLOYER_PRIVATE_KEY`.
DEPLOYER_PRIVATE_KEY=

# --- Gas sponsorship (script/bundler_userop.py sponsor) ---------------------
# Both are required together. Without them the harness uses the public bundler,
# which sends operations but sponsors nothing:
#   pm_getPaymasterStubData -> "Sponsorship policy ID is required for this API key"
# The policy must allow-list DeadManSwitch, ProofRegistry AND the factory --
# omitting the factory refuses the one operation a new user cannot pay for.
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=

# --- Deploy.s.sol ----------------------------------------------------------
# PRODUCTION=true enforces the mainnet floors (30 days / 7 days) and rejects
# anything lower. Unset means testnet: 5 minutes / 2 minutes.
PRODUCTION=false
# Optional overrides for the minimum periods, in seconds. Whatever is in force
# at broadcast MUST be copied into the deployment record.
# MIN_INACTIVITY_SECONDS=300
# MIN_CONTEST_SECONDS=120
